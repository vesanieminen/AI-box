[Unit]
Description=Local Ollama AI server with model preload
After=local-fs.target
RequiresMountsFor=/home/vesanieminen/.local/share/ollama

[Service]
Type=simple
User=vesanieminen
Group=vesanieminen
WorkingDirectory=/home/vesanieminen
ExecStart=/usr/bin/ollama serve
ExecStartPost=/usr/bin/python3 /home/vesanieminen/.local/share/ollama/warm-start.py
Environment="OLLAMA_HOST=0.0.0.0:11434"
Environment="OLLAMA_MODELS=/home/vesanieminen/.local/share/ollama/models"
Environment="OLLAMA_CONTEXT_LENGTH=8192"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_MAX_LOADED_MODELS=1"
Environment="OLLAMA_FLASH_ATTENTION=1"
Environment="OLLAMA_KV_CACHE_TYPE=q8_0"
Environment="OLLAMA_KEEP_ALIVE=-1"
Environment="OLLAMA_NO_CLOUD=1"
Restart=always
RestartSec=5
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
